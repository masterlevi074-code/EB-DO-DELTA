	TweenService:Create(N, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {Position = UDim2.new(0, 0, 0, 0)}):Play()

	task.delay(1.8, function()
		local Tween = TweenService:Create(N, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {Position = UDim2.new(1, 8, 0, 0)})
		Tween:Play()
		Tween.Completed:Wait()
		N:Destroy()
	end)
end

