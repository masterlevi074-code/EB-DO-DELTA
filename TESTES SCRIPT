    if ChatWindow_Conexoes then pcall(function() ChatWindow_Conexoes.ChatWindow.ToggleVisibility:Destroy(); ChatWindow_Conexoes.ChatWindow.SetVisible:Destroy(); ChatWindow_Conexoes.ChatWindow.VisibilityStateChanged:Destroy() end); ChatWindow_Conexoes = nil end
