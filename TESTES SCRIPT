            local humanoid = char:FindFirstChild("Humanoid")
            if not root or not humanoid then return end
            if humanoid.MoveDirection.Magnitude > 0 then
                local moveDirection = humanoid.MoveDirection
                local speed = SpeedHack_Velocidade * 0.5
                root.CFrame = root.CFrame + (moveDirection * speed / 60)
            end
        end)
    else
        if SpeedHack_Conexao then SpeedHack_Conexao:Disconnect(); SpeedHack_Conexao = nil end
    end
end)

