    elseif cmd == "sit" then
        if resto == "" then if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then localPlayer.Character.Humanoid.Sit = true end
        else local alvo = EncontrarJogadorAdmin(resto); if alvo and alvo.Character and alvo.Character:FindFirstChild("Humanoid") then alvo.Character.Humanoid.Sit = true end
