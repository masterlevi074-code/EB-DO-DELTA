	local SwitchCorner = Instance.new("UICorner")
	SwitchCorner.CornerRadius = UDim.new(1, 0)
	SwitchCorner.Parent = Switch

	local Circle = Instance.new("Frame")
	Circle.Size = UDim2.fromOffset(12, 12)
	Circle.Position = UDim2.fromOffset(2, 2)
	Circle.BackgroundColor3 = COLORS.Text
	Circle.BorderSizePixel = 0
	Circle.Parent = Switch

	local CircleCorner = Instance.new("UICorner")
	CircleCorner.CornerRadius = UDim.new(1, 0)
	CircleCorner.Parent = Circle

	local function Update()
		local SwitchColor = State and Accent or COLORS.OliveDark
		local CirclePosition = State and UDim2.new(1, -14, 0, 2) or UDim2.fromOffset(2, 2)
		TweenService:Create(Switch, TweenInfo.new(0.12), {BackgroundColor3 = SwitchColor}):Play()
		TweenService:Create(Circle, TweenInfo.new(0.12), {Position = CirclePosition}):Play()
		if Callback then Callback(State) end
	end

	Button.MouseButton1Click:Connect(function()
		State = not State
		Update()
	end)

	Update()
	return {Set = function(Value) State = Value; Update() end}
end

