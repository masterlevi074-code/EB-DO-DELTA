            local root = p.Character.HumanoidRootPart; local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local mostrar = true
                if ESP_TimesAtivado then local timePlayer = GetPlayerTime(p); if timePlayer then mostrar = TimesMarcados[timePlayer] or false else mostrar = false end end
                if mostrar then local posTela, visivel = camera:WorldToViewportPoint(root.Position)
                    if visivel then tracer.From = centroBaseTela; tracer.To = Vector2.new(posTela.X, posTela.Y); tracer.Visible = true else tracer.Visible = false end
                else tracer.Visible = false end
            else tracer.Visible = false end
        else if tracer then tracer.Visible = false end end
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum then
                if ESP_GlobalAtivado and ESP_Names then
                    local nameGui = head:FindFirstChild("NoahzinName")
                    if nameGui and nameGui:FindFirstChild("TextLabel") then
                        nameGui.TextLabel.Text = p.Name
                    end
                end
                if ESP_TimesNomes then
                    local timeGui = head:FindFirstChild("NoahzinTime")
                    if timeGui and timeGui:FindFirstChild("TextLabel") then
                        timeGui.TextLabel.Text = p.Team and p.Team.Name or "SEM TIME"
                    end
                end
                if ESP_GlobalAtivado and ESP_BarraVida then
                    local barraGui = head:FindFirstChild("NoahzinBarraVida")
                    local fundo = barraGui and barraGui:FindFirstChild("Fundo")
                    local preenchimento = fundo and fundo:FindFirstChild("Preenchimento")
                    if preenchimento then
                        local porcentagem = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        preenchimento.Size = UDim2.new(porcentagem, 0, 1, 0)
                        preenchimento.BackgroundColor3 = Color3.fromRGB(255, 70, 70):Lerp(Color3.fromRGB(70, 255, 100), porcentagem)
                    end
                end
                if ESP_GlobalAtivado and ESP_Arma then
                    local armaGui = head:FindFirstChild("NoahzinArma")
                    local armaLabel = armaGui and armaGui:FindFirstChild("TextLabel")
                    if armaLabel then armaLabel.Text = GetEquippedWeaponName(p.Character) end
                end
                if ESP_GlobalAtivado and ESP_Distancia then
                    local distanciaGui = head:FindFirstChild("NoahzinDistancia")
                    local meuHead = Player.Character and Player.Character:FindFirstChild("Head")
                    if distanciaGui and distanciaGui:FindFirstChild("TextLabel") and meuHead then
                        distanciaGui.TextLabel.Text = string.format("[%dm]", math.floor((head.Position - meuHead.Position).Magnitude))
                    end
                end
            end
        end
    end
    if BlocosAtivado and Player.Character then
