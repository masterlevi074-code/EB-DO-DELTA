            SectionShine.Position = UDim2.new(0, -8, 0, 0)
            task.wait(1.4)
        end
    end)

    task.spawn(function()
        local random = Random.new()
        while Header and Header.Parent do
            local dot = Instance.new("Frame")
            local dotSize = random:NextInteger(1, 2)
            dot.Size = UDim2.fromOffset(dotSize, dotSize)
            dot.Position = UDim2.new(random:NextNumber(0.15, 0.92), 0, random:NextNumber(0.25, 0.8), 0)
            dot.BackgroundColor3 = random:NextNumber() > 0.5 and Accent or COLORS.Green
            dot.BackgroundTransparency = 0.25
            dot.BorderSizePixel = 0
            dot.ZIndex = 2
            dot.Parent = Header
            local dotCorner = Instance.new("UICorner")
            dotCorner.CornerRadius = UDim.new(1, 0)
            dotCorner.Parent = dot
            local fade = TweenService:Create(dot, TweenInfo.new(random:NextNumber(0.8, 1.5), Enum.EasingStyle.Sine), {
                Position = UDim2.new(dot.Position.X.Scale + random:NextNumber(-0.08, 0.08), 0, dot.Position.Y.Scale - 0.2, 0),
                BackgroundTransparency = 1
            })
            fade:Play()
            fade.Completed:Connect(function()
                if dot then dot:Destroy() end
            end)
            task.wait(0.55)
        end
    end)
    
    table.insert(SectionContainers[PageName], Container)
    
    return Container
end

