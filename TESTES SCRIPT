        StartHeight = Main.AbsoluteSize.Y
        ResizeHandle.BackgroundColor3 = Accent
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if not Resizing then return end
    if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseMovement then
        local Delta = Input.Position - ResizeStart
        local NewWidth = math.clamp(StartWidth + Delta.X, MIN_WIDTH, MAX_WIDTH)
        local NewHeight = math.clamp(StartHeight + Delta.Y, MIN_HEIGHT, MAX_HEIGHT)
        Main.Size = UDim2.fromOffset(NewWidth, NewHeight)
    end
end)

UserInputService.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Resizing = false
        ResizeHandle.BackgroundColor3 = COLORS.OliveDark
    end
end)

