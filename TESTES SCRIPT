local ParticleRandom = Random.new()
local function CriarParticula()
    if not ParticleLayer or not ParticleLayer.Parent then return end
    local particle = Instance.new("Frame")
    local size = ParticleRandom:NextInteger(1, 3)
    particle.Size = UDim2.fromOffset(size, size)
    particle.Position = UDim2.new(ParticleRandom:NextNumber(0.02, 0.98), 0, 1.05, 0)
    particle.BackgroundColor3 = ParticleRandom:NextNumber() > 0.5 and COLORS.Olive or COLORS.Green
    particle.BackgroundTransparency = 0.45
    particle.BorderSizePixel = 0
    particle.ZIndex = 1
    particle.Parent = ParticleLayer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = particle

    local destino = UDim2.new(
        particle.Position.X.Scale + ParticleRandom:NextNumber(-0.08, 0.08), 0,
        -0.08, 0
    )
    local duracao = ParticleRandom:NextNumber(4, 7)
    local tween = TweenService:Create(particle, TweenInfo.new(duracao, Enum.EasingStyle.Linear), {
        Position = destino,
        BackgroundTransparency = 1
    })
    tween:Play()
    tween.Completed:Connect(function()
        if particle then particle:Destroy() end
    end)
end

task.spawn(function()
    while ParticleLayer and ParticleLayer.Parent do
        CriarParticula()
        task.wait(0.35)
    end
end)

