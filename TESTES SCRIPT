local function AnimarBotao(button)
    if not button:IsA("TextButton") then return end
    local escala = Instance.new("UIScale")
    escala.Scale = 1
    escala.Parent = button
    local corOriginal = button.BackgroundColor3
    local conectado = false

    button.MouseEnter:Connect(function()
        conectado = true
        TweenService:Create(escala, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1.035}):Play()
        TweenService:Create(button, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {BackgroundColor3 = button.BackgroundColor3:Lerp(Color3.new(1, 1, 1), 0.08)}):Play()
    end)
    button.MouseLeave:Connect(function()
        conectado = false
        TweenService:Create(escala, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
        TweenService:Create(button, TweenInfo.new(0.16, Enum.EasingStyle.Quad), {BackgroundColor3 = corOriginal}):Play()
    end)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(escala, TweenInfo.new(0.06, Enum.EasingStyle.Quad), {Scale = 0.96}):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(escala, TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = conectado and 1.035 or 1}):Play()
    end)
end

for _, object in ipairs(Gui:GetDescendants()) do
    AnimarBotao(object)
end

