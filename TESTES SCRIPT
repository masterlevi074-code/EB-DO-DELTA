        local botaoAba = criarInstancia("TextButton", {
            Size = UDim2.new(1, -6, 0, mobile and 36 or 32),
            BackgroundColor3 = Cores.Fundo3,
            Text = (icone ~= "" and icone .. "  " or "") .. tituloAba,
            TextColor3 = Cores.Texto2,
            Font = FonteTitulo,
            TextSize = mobile and 13 or 12,
            BorderSizePixel = 0,
            Parent = containerAbas,
        })
        adicionarCanto(botaoAba, 7)

        local pagina = criarInstancia("ScrollingFrame", {
            Size = UDim2.new(1, -16, 1, -16),
            Position = UDim2.new(0, 8, 0, 8),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            Visible = false,
            Parent = areaPaginas,
        })

        local listaPagina = criarInstancia("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            Parent = pagina,
        })

        local layoutCounter = 0

        local function novoLayoutOrder()
            layoutCounter = layoutCounter + 1
            return layoutCounter
        end

        local abaObj = {
            Botao = botaoAba,
            Pagina = pagina,
            Lista = listaPagina,
            _novoLayoutOrder = novoLayoutOrder,
        }

        function abaObj:Section(config)
            local tituloSecao = config.Title or "Seção"
            local secao = criarInstancia("Frame", {
                Size = UDim2.new(1, 0, 0, mobile and 28 or 26),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Parent = pagina,
                LayoutOrder = novoLayoutOrder(),
            })

            local linha = criarInstancia("Frame", {
                Size = UDim2.new(0, 3, 1, 0),
                BackgroundColor3 = Cores.Destaque,
                BorderSizePixel = 0,
                Parent = secao,
            })
            adicionarCanto(linha, 2)

            local tituloLabel = criarInstancia("TextLabel", {
                Size = UDim2.new(1, -20, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = tituloSecao,
                TextColor3 = Cores.Texto,
                Font = FonteTitulo,
                TextSize = mobile and 14 or 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = secao,
            })

            return secao
        end

        function abaObj:Toggle(config)
            return criarToggle(config, pagina, novoLayoutOrder())
        end

        function abaObj:Button(config)
            return criarBotao(config, pagina, novoLayoutOrder())
        end

        function abaObj:Slider(config)
            return criarSlider(config, pagina, novoLayoutOrder())
        end

        function abaObj:Input(config)
            return criarInput(config, pagina, novoLayoutOrder())
        end

        function abaObj:Dropdown(config)
            return criarDropdown(config, pagina, novoLayoutOrder())
        end

        function abaObj:Label(config)
            return criarLabel(config, pagina, novoLayoutOrder())
        end

        botaoAba.MouseButton1Click:Connect(function()
            janelaObj:SelectTab(abaObj)
        end)

        table.insert(janelaObj.Abas, abaObj)

        if #janelaObj.Abas == 1 then
            janelaObj:SelectTab(abaObj)
        end

        return abaObj
    end

    function janelaObj:Destroy()
        screenGui:Destroy()
    end

    -- Implementação do arrasto manual (corrigido)
    local arrastando = false
    local offsetDrag = Vector2.new(0, 0)

    barraTitulo.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            arrastando = true
            local posMouse = UserInputService:GetMouseLocation()
            -- Obter posição do canto superior esquerdo da sombra
            local posJanela = sombra.AbsolutePosition
            offsetDrag = Vector2.new(posMouse.X - posJanela.X, posMouse.Y - posJanela.Y)
            -- Mudar AnchorPoint para (0,0) e ajustar Position para manter a posição visual
            local absPos = sombra.AbsolutePosition
            sombra.AnchorPoint = Vector2.new(0, 0)
            sombra.Position = UDim2.new(0, absPos.X, 0, absPos.Y)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if arrastando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local posMouse = UserInputService:GetMouseLocation()
            local novaPos = Vector2.new(posMouse.X - offsetDrag.X, posMouse.Y - offsetDrag.Y)
            sombra.Position = UDim2.new(0, novaPos.X, 0, novaPos.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            arrastando = false
        end
    end)

    -- Função para minimizar (esconde janela e fundo, mostra botão flutuante)
    local botaoMinimizado = nil -- será criado quando minimizar
    local function Minimizar()
        sombra.Visible = false
        fundo.Visible = false
        
        -- Criar botão flutuante pequeno
        if not botaoMinimizado then
            botaoMinimizado = criarInstancia("TextButton", {
                Size = UDim2.fromOffset(56, 56),
                Position = UDim2.new(0.9, 0, 0.8, 0),
                BackgroundColor3 = Cores.Destaque,
                Text = "🛡️",
                TextColor3 = Cores.Branco,
                Font = FonteTitulo,
                TextSize = 24,
                BorderSizePixel = 0,
                Parent = screenGui,
                Draggable = true, -- permite arrastar o botão
            })
            adicionarCanto(botaoMinimizado, 28)
            adicionarBorda(botaoMinimizado, Cores.Branco, 2)
            
            -- Animação sutil de escala
            botaoMinimizado.Size = UDim2.fromOffset(0, 0)
            botaoMinimizado:TweenSize(UDim2.fromOffset(56, 56), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
            
            botaoMinimizado.MouseButton1Click:Connect(function()
                -- Maximizar: mostrar janela e fundo, destruir botão
                sombra.Visible = true
                fundo.Visible = true
                -- Restaurar AnchorPoint e posição central? Melhor deixar onde estava
                if botaoMinimizado then
                    botaoMinimizado:Destroy()
                    botaoMinimizado = nil
                end
            end)
        else
            botaoMinimizado.Visible = true
        end
    end

    botaoMinimizar.MouseButton1Click:Connect(Minimizar)

    botaoFechar.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    return janelaObj
end

