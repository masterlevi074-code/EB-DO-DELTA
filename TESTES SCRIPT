        barBg.Size = UDim2.new(0, 2, 0, 12)
        barBg.Position = UDim2.new(0, 4, 0, 4)
        barBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        barBg.BorderSizePixel = 0
        barBg.Parent = bgVida

        local barBgCorner = Instance.new("UICorner")
        barBgCorner.CornerRadius = UDim.new(0, 1)
        barBgCorner.Parent = barBg

        local barFill = barBg:FindFirstChild("BarFill") or Instance.new("Frame")
        barFill.Name = "BarFill"
        barFill.Size = UDim2.new(1, 0, 1, 0)
        barFill.Position = UDim2.new(0, 0, 0, 0)
        barFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        barFill.BorderSizePixel = 0
        barFill.Parent = barBg

        local barFillCorner = Instance.new("UICorner")
        barFillCorner.CornerRadius = UDim.new(0, 1)
        barFillCorner.Parent = barFill

        -- Patente
        local bgPatente = head:FindFirstChild("NoahzinPatente") or Instance.new("BillboardGui")
        bgPatente.Name = "NoahzinPatente"
        bgPatente.Size = UDim2.new(0, 100, 0, 20)
        bgPatente.AlwaysOnTop = true
        bgPatente.ExtentsOffset = Vector3.new(0, 8, 0)
        bgPatente.Enabled = ESP_Patente
        bgPatente.Parent = head

        local tlPatente = bgPatente:FindFirstChild("TextLabel") or Instance.new("TextLabel")
        tlPatente.Size = UDim2.new(1, 0, 1, 0)
        tlPatente.BackgroundTransparency = 1
        tlPatente.Text = ""
        tlPatente.TextColor3 = Color3.fromRGB(255, 215, 0)
        tlPatente.Font = Enum.Font.GothamBold
        tlPatente.TextSize = 10
        tlPatente.TextStrokeTransparency = 0
        tlPatente.Parent = bgPatente

        local box = c:FindFirstChild("NoahzinBox") or Instance.new("SelectionBox")
        box.Name = "NoahzinBox"; box.Adornee = c; pcall(function() box.Color3 = CorESP end)
        box.LineThickness = 0.05; box.SurfaceTransparency = 1; box.Visible = ESP_Box; box.Parent = c

        if not LinhasTracers[p] then
            local tracer = Drawing.new("Line"); tracer.Visible = false
            pcall(function() tracer.Color = CorESP end); tracer.Thickness = 1.2; LinhasTracers[p] = tracer
        end
        if not SkeletonLines[p] then
            CriarSkeleton(p)
        end
        task.spawn(AtualizarESP)
    end
    if p.Character then AdicionarUI(p.Character) end
    p.CharacterAdded:Connect(function(char)
        -- Limpar linhas antigas do skeleton ao renascer
        if SkeletonLines[p] then
            for _, line in pairs(SkeletonLines[p]) do line:Destroy() end
            SkeletonLines[p] = nil
        end
        AdicionarUI(char)
    end)
end

