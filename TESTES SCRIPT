local function EncontrarJogadorAdmin(nome)
    nome = nome:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():find(nome, 1, true) or (p.DisplayName and p.DisplayName:lower():find(nome, 1, true)) then return p end
    end
    return nil
end

local function ExecutarComandoAdmin(mensagem)
    if not Admin_Ativado then return end
    if not mensagem:sub(1, #Admin_Prefixo) == Admin_Prefixo then return end
    
    local comando = mensagem:sub(#Admin_Prefixo + 1)
    local args = comando:split(" ")
    local cmd = args[1]:lower()
    table.remove(args, 1)
    local resto = table.concat(args, " ")
    
    if cmd == "to" or cmd == "tp" then
        local alvo = EncontrarJogadorAdmin(resto)
        if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") and Player.Character then
            Player.Character.HumanoidRootPart.CFrame = alvo.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
        end
    elseif cmd == "bring" then
        local alvo = EncontrarJogadorAdmin(resto)
        if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") and Player.Character then
            alvo.Character.HumanoidRootPart.CFrame = Player.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
        end
    elseif cmd == "respawn" then
        if resto == "all" then for _, p in pairs(Players:GetPlayers()) do if p ~= Player then pcall(function() p:LoadCharacter() end) end end
        else local alvo = EncontrarJogadorAdmin(resto); if alvo then pcall(function() alvo:LoadCharacter() end) end
        end
    elseif cmd == "invis" then
        if Player.Character then for _, part in pairs(Player.Character:GetDescendants()) do if part:IsA("BasePart") then part.Transparency = 0.9 end end; Admin_Invisivel = true end
    elseif cmd == "vis" then
        if Player.Character then for _, part in pairs(Player.Character:GetDescendants()) do if part:IsA("BasePart") then part.Transparency = 0 end end; Admin_Invisivel = false end
    elseif cmd == "view" then
        local alvo = EncontrarJogadorAdmin(resto)
        if alvo and alvo.Character then Workspace.CurrentCamera.CameraSubject = alvo.Character:FindFirstChild("Humanoid") or alvo.Character end
    elseif cmd == "unview" then
        Workspace.CurrentCamera.CameraSubject = Player.Character and Player.Character:FindFirstChild("Humanoid") or Player.Character
    elseif cmd == "sit" then
        local alvo = EncontrarJogadorAdmin(resto)
        if alvo and alvo.Character and alvo.Character:FindFirstChild("Humanoid") then alvo.Character.Humanoid.Sit = true end
    elseif cmd == "jump" then
