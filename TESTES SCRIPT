local function GetPlayerTime(player)
    if player.Team then
        local teamName = player.Team.Name
        for time, _ in pairs(TimesMarcados) do
            if teamName:find(time:gsub("%[", ""):gsub("%]", ""), 1, true) then return time end
        end
    end
    return nil
end

local function GetTeamColor(player)
    local team = player.Team
    if team then
        local teamColor = team.TeamColor
        if teamColor and teamColor ~= BrickColor.new("White") then
            return teamColor.Color
        end
    end
    return nil
end

local function AtualizarESP()
    if not CorESP then CorESP = Color3.fromRGB(255, 50, 50) end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local mostrarESP = true
            if ESP_TimesAtivado then
                local timePlayer = GetPlayerTime(p)
                if timePlayer then mostrarESP = TimesMarcados[timePlayer] or false else mostrarESP = false end
            end
            local teamColor = GetTeamColor(p)
            local corUsar = teamColor or CorESP
            local h = p.Character:FindFirstChild("NoahzinESP")
            if h then h.Enabled = ESP_Chams and mostrarESP; pcall(function() h.FillColor = corUsar end) end
            local box = p.Character:FindFirstChild("NoahzinBox")
            if box then box.Visible = ESP_Box and mostrarESP; pcall(function() box.Color3 = corUsar end) end
            local head = p.Character:FindFirstChild("Head")
            if head then
                local nameGui = head:FindFirstChild("NoahzinName")
                if nameGui then nameGui.Enabled = ESP_Names and mostrarESP
                    if nameGui:FindFirstChild("TextLabel") then pcall(function() nameGui.TextLabel.TextColor3 = corUsar end) end
                end
                local vidaGui = head:FindFirstChild("NoahzinVida")
                if vidaGui then
                    vidaGui.Enabled = ESP_Vida and mostrarESP
                end
                local patenteGui = head:FindFirstChild("NoahzinPatente")
                if patenteGui then
                    patenteGui.Enabled = ESP_Patente and mostrarESP
                end
            end
            if LinhasTracers[p] then pcall(function() LinhasTracers[p].Color = corUsar end); LinhasTracers[p].Visible = ESP_Tracers and mostrarESP end
        end
    end
end

local function CriarSkeleton(p)
    if SkeletonLines[p] then
        for _, line in pairs(SkeletonLines[p]) do
            line:Destroy()
        end
    end
    SkeletonLines[p] = {}
    local char = p.Character
    if not char then return end
    local pairsList = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
    }
    for _ = 1, #pairsList do
        local line = Drawing.new("Line")
        line.Color = CorESP
        line.Thickness = 1
        line.Visible = false
        table.insert(SkeletonLines[p], line)
    end
end

local function AtualizarSkeleton(p)
    if not ESP_Skeleton or not p.Character then
        return
    end
    local char = p.Character
    local lines = SkeletonLines[p]
    if not lines then
        CriarSkeleton(p)
        lines = SkeletonLines[p]
    end
    local pairsList = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
    }
    local camera = Workspace.CurrentCamera
    for i, pair in ipairs(pairsList) do
        local partA = char:FindFirstChild(pair[1])
        local partB = char:FindFirstChild(pair[2])
        local line = lines[i]
        if partA and partB and line then
            local posA, visA = camera:WorldToViewportPoint(partA.Position)
            local posB, visB = camera:WorldToViewportPoint(partB.Position)
            if visA and visB then
                line.From = Vector2.new(posA.X, posA.Y)
                line.To = Vector2.new(posB.X, posB.Y)
                line.Visible = true
                line.Color = GetTeamColor(p) or CorESP
            else
                line.Visible = false
            end
        elseif line then
            line.Visible = false
        end
    end
end

