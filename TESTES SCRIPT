local function AdicionarDescricao(object, nome)
    local descricao = FunctionDescriptions[nome] or ("Configura a função " .. nome .. ".")
    if not object or not object.Parent then return end

    local isToggle = object:IsA("TextButton") and object.Text == ""
    if isToggle then
        local optionLabel = object:FindFirstChildOfClass("TextLabel")
        if optionLabel then
            optionLabel.Position = UDim2.fromOffset(10, 1)
            optionLabel.Size = UDim2.new(1, -55, 0, 16)
            optionLabel.TextYAlignment = Enum.TextYAlignment.Center
        end
        local switch = object:FindFirstChildOfClass("Frame")
        if switch then switch.Position = UDim2.new(1, -40, 0.5, -8) end
    elseif object:IsA("TextButton") then
        object.TextYAlignment = Enum.TextYAlignment.Top
        object.TextXAlignment = Enum.TextXAlignment.Left
        local padding = object:FindFirstChild("DescriptionPadding") or Instance.new("UIPadding")
        padding.Name = "DescriptionPadding"
        padding.PaddingTop = UDim.new(0, 3)
        padding.PaddingLeft = UDim.new(0, 10)
        padding.Parent = object
    end

    local label = object:FindFirstChild("FunctionDescription") or Instance.new("TextLabel")
    label.Name = "FunctionDescription"
    label.BackgroundTransparency = 1
    label.Position = isToggle and UDim2.fromOffset(10, 17) or UDim2.fromOffset(10, 16)
    label.Size = UDim2.new(1, -20, 0, 8)
    label.Text = descricao
    label.TextColor3 = COLORS.Muted
    label.TextSize = 6
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.ZIndex = (object.ZIndex or 1) + 1
    label.Parent = object
end
