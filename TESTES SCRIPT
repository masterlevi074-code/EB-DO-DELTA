--========================================================--
-- SECTION (COM CONTAINER PRÓPRIO - CORRIGIDO)
--========================================================--

local SectionContainers = {}

local function Section(Page, Text)
    local PageName = Page.Name
    
    -- Inicializar contador se não existir
    if not SectionContainers[PageName] then
        SectionContainers[PageName] = {}
    end
    
    -- Calcular LayoutOrder baseado no número de seções existentes
    local SectionOrder = (#SectionContainers[PageName] + 1) * 100
    
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -4, 0, 0)
    Container.AutomaticSize = Enum.AutomaticSize.Y  -- Altura automática
    Container.BackgroundTransparency = 1
    Container.BorderSizePixel = 0
    Container.LayoutOrder = SectionOrder
    Container.Parent = Page
    
    local ContainerLayout = Instance.new("UIListLayout")
    ContainerLayout.Padding = UDim.new(0, 4)
    ContainerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    ContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ContainerLayout.Parent = Container
    
    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 20)
    Header.BackgroundColor3 = COLORS.Panel2
    Header.BorderSizePixel = 0
    Header.LayoutOrder = 0
    Header.Parent = Container
    
    local HeaderCorner = Instance.new("UICorner")
    HeaderCorner.CornerRadius = UDim.new(0, 4)
    HeaderCorner.Parent = Header
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -8, 1, 0)
    Label.Position = UDim2.fromOffset(4, 0)
    Label.BackgroundTransparency = 1
    Label.Text = "▸ " .. Text
    Label.TextColor3 = Accent
    Label.TextSize = 7
    Label.Font = Enum.Font.GothamBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Header
    
    table.insert(SectionContainers[PageName], Container)
    
    return Container
end

