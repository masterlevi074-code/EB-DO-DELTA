local function criarSlider(config, parent, layoutOrder)
    local frame = criarInstancia("Frame", {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = Cores.Fundo2,
        BorderSizePixel = 0,
        Parent = parent,
        LayoutOrder = layoutOrder,
    })
    adicionarCanto(frame, 7)
    adicionarBorda(frame, Color3.fromRGB(60, 60, 70), 1)

    local tituloLabel = criarInstancia("TextLabel", {
        Size = UDim2.new(1, -60, 0, 18),
        Position = UDim2.new(0, 10, 0, 4),
        BackgroundTransparency = 1,
        Text = config.Title or "Slider",
        TextColor3 = Cores.Texto,
        Font = FonteTitulo,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local valorLabel = criarInstancia("TextLabel", {
        Size = UDim2.new(0, 50, 0, 18),
        Position = UDim2.new(1, -60, 0, 4),
        BackgroundTransparency = 1,
        Text = tostring(config.Value.Default or 0),
        TextColor3 = Cores.Destaque,
        Font = FonteTitulo,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })

    local slider = criarInstancia("TextButton", {
        Size = UDim2.new(1, -20, 0, 8),
        Position = UDim2.new(0, 10, 0, 26),
        BackgroundColor3 = Cores.Fundo3,
        BorderSizePixel = 0,
        Text = "",
        Parent = frame,
    })
    adicionarCanto(slider, 4)

    local preenchimento = criarInstancia("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Cores.Destaque,
        BorderSizePixel = 0,
        Parent = slider,
    })
    adicionarCanto(preenchimento, 4)

    local min = config.Value.Min or 0
    local max = config.Value.Max or 100
    local default = config.Value.Default or min
    local step = config.Step or 1

    local valorAtual = default
    local arrastando = false

    local function atualizarVisual()
        local fracao = (valorAtual - min) / (max - min)
        preenchimento.Size = UDim2.new(fracao, 0, 1, 0)
        valorLabel.Text = tostring(valorAtual)
    end

    local function definirValor(novoValor)
        novoValor = math.clamp(novoValor, min, max)
        if step ~= 1 then
            novoValor = math.floor(novoValor / step + 0.5) * step
        end
        valorAtual = novoValor
        atualizarVisual()
        if config.Callback then
            config.Callback(valorAtual)
        end
    end

    slider.MouseButton1Down:Connect(function()
        arrastando = true
        local conexao
        conexao = RunService.RenderStepped:Connect(function()
            if not arrastando then
                conexao:Disconnect()
                return
            end
            local mousePos = UserInputService:GetMouseLocation()
            local posX = slider.AbsolutePosition.X
            local tamanhoX = slider.AbsoluteSize.X
            local fracao = (mousePos.X - posX) / tamanhoX
            fracao = math.clamp(fracao, 0, 1)
            definirValor(min + fracao * (max - min))
        end)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            arrastando = false
        end
    end)

    atualizarVisual()

    local obj = {
        Frame = frame,
        Set = function(self, valor)
            definirValor(valor)
        end,
        Get = function(self)
            return valorAtual
        end,
    }
    return obj
end

