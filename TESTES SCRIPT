	local function Update()
		local SwitchColor = State and Accent or COLORS.OliveDark
		local CirclePosition = State and UDim2.new(1, -17, 0, 2) or UDim2.fromOffset(2, 2)
		TweenService:Create(Switch, TweenInfo.new(0.15), {BackgroundColor3 = SwitchColor}):Play()
		TweenService:Create(Circle, TweenInfo.new(0.15), {Position = CirclePosition}):Play()
		if Callback then Callback(State) end
	end

	Button.MouseButton1Click:Connect(function()
		State = not State
		Update()
	end)

	Update()
	return {Set = function(Value) State = Value; Update() end}
end

