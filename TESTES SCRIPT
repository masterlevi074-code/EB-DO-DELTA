    elseif cmd == "hipheight" then
        local valor = tonumber(resto)
        if valor and Player.Character and Player.Character:FindFirstChild("Humanoid") then Player.Character.Humanoid.HipHeight = valor end
    elseif cmd == "char" or cmd == "skin" then
        local alvo = EncontrarJogadorAdmin(resto)
