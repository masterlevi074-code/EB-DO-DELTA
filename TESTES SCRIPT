    Branco = Color3.fromRGB(255, 255, 255),
    Preto = Color3.fromRGB(0, 0, 0),
    Sombra = Color3.fromRGB(0, 0, 0),
}

local FontePadrao = Enum.Font.SourceSans
local FonteTitulo = Enum.Font.SourceSansBold

local function isMobile()
    return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function criarInstancia(classe, propriedades)
    local instancia = Instance.new(classe)
    for prop, valor in pairs(propriedades or {}) do
        instancia[prop] = valor
    end
    return instancia
end

local function adicionarCanto(instancia, raio)
    local canto = Instance.new("UICorner")
    canto.CornerRadius = UDim.new(0, raio)
    canto.Parent = instancia
    return canto
end

local function adicionarBorda(instancia, cor, espessura)
    local borda = Instance.new("UIStroke")
    borda.Color = cor or Cores.Destaque
    borda.Thickness = espessura or 1
    borda.Parent = instancia
    return borda
end

function NoxysUI:Notify(titulo, conteudo, duracao)
    duracao = duracao or 3
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "NoxysNotify"
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = CoreGui

    local frame = criarInstancia("Frame", {
        Size = UDim2.fromOffset(260, 70),
        Position = UDim2.new(1, -280, 0, -100),
        BackgroundColor3 = Cores.Fundo2,
        BorderSizePixel = 0,
        Active = true,
        Draggable = false,
        Parent = screenGui,
    })
    adicionarCanto(frame, 8)
    adicionarBorda(frame, Cores.Destaque, 1.5)

    local tituloLabel = criarInstancia("TextLabel", {
        Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.new(0, 10, 0, 5),
        BackgroundTransparency = 1,
        Text = titulo,
        TextColor3 = Cores.Texto,
        Font = FonteTitulo,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local conteudoLabel = criarInstancia("TextLabel", {
        Size = UDim2.new(1, -20, 0, 35),
        Position = UDim2.new(0, 10, 0, 30),
        BackgroundTransparency = 1,
        Text = conteudo,
        TextColor3 = Cores.Texto2,
        Font = FontePadrao,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    frame:TweenPosition(UDim2.new(1, -280, 0, 20), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)

    task.delay(duracao, function()
        frame:TweenPosition(UDim2.new(1, -280, 0, -100), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
        task.wait(0.3)
        screenGui:Destroy()
    end)
end

