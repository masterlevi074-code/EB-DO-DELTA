Toggle(MovementPage, "UNDERGROUND", false, function(State)
    Underground_Ativado = State
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then Underground_Ativado = false; return end
    local root = char.HumanoidRootPart
    if State then
        Underground_Voltando = false
        if not Underground_CameraPart then
            Underground_CameraPart = Instance.new("Part")
            Underground_CameraPart.Name = "CameraGhost"
            Underground_CameraPart.Size = Vector3.new(1, 1, 1)
            Underground_CameraPart.Anchored = true
            Underground_CameraPart.CanCollide = false
            Underground_CameraPart.Transparency = 1
            Underground_CameraPart.Parent = Workspace
        end
        Underground_CameraPart.CFrame = CFrame.new(root.Position.X, Underground_yCamera, root.Position.Z)
        root.CFrame = CFrame.new(root.Position.X, Underground_yAbaixo, root.Position.Z)
        if Underground_Conexao then Underground_Conexao:Disconnect() end
        Underground_Conexao = RunService.Heartbeat:Connect(function()
            if not Underground_Ativado or Underground_Voltando then return end
            local charAtual = Player.Character
            if not charAtual or not charAtual:FindFirstChild("HumanoidRootPart") then return end
            local rootAtual = charAtual.HumanoidRootPart
            if rootAtual.Position.Y < -22 then rootAtual.CFrame = CFrame.new(rootAtual.Position.X, -19, rootAtual.Position.Z) end
            if Underground_CameraPart then Underground_CameraPart.CFrame = CFrame.new(rootAtual.Position.X, Underground_yCamera, rootAtual.Position.Z) end
        end)
        local camera = Workspace.CurrentCamera
        camera.CameraSubject = Underground_CameraPart
        camera.CameraType = Enum.CameraType.Follow
    else
        Underground_Voltando = true
        if Underground_Conexao then Underground_Conexao:Disconnect(); Underground_Conexao = nil end
        local camera = Workspace.CurrentCamera
        if camera then camera.CameraSubject = Player.Character and Player.Character:FindFirstChild("Humanoid"); camera.CameraType = Enum.CameraType.Follow end
        if Underground_CameraPart then Underground_CameraPart:Destroy(); Underground_CameraPart = nil end
        root.CFrame = CFrame.new(root.Position.X, Underground_yCamera, root.Position.Z)
        task.wait(0.5)
        Underground_Voltando = false
    end
end)

Toggle(MovementPage, "PASSE LIVRE", false, function(State)
    PasseLivre_Ativado = State
    if State then
        if PasseLivre_Conexao then PasseLivre_Conexao:Disconnect() end
        PasseLivre_Conexao = RunService.Heartbeat:Connect(function()
            if not PasseLivre_Ativado then return end
            local char = Player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local root = char.HumanoidRootPart
            local posHorizontal = Vector3.new(root.Position.X, 0, root.Position.Z)
            local centroHorizontal = Vector3.new(PasseLivre_Centro.X, 0, PasseLivre_Centro.Z)
            local distancia = (posHorizontal - centroHorizontal).Magnitude
            if distancia <= PasseLivre_Raio then
                if not PasseLivre_NoClipAtivo then
                    PasseLivre_NoClipAtivo = true
                    for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = false end end
                    root.CanCollide = false
                    Notify("Noclip ATIVADO")
                end
            else
                if PasseLivre_NoClipAtivo then
                    PasseLivre_NoClipAtivo = false
                    for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = true end end
                    Notify("Noclip DESATIVADO")
                end
            end
        end)
    else
        if PasseLivre_Conexao then PasseLivre_Conexao:Disconnect(); PasseLivre_Conexao = nil end
        if PasseLivre_NoClipAtivo then
            PasseLivre_NoClipAtivo = false
            local char = Player.Character
            if char then for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = true end end end
        end
    end
end)

