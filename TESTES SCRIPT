local function AtivarChatWindow()
    if ChatWindow_Conexoes then DesativarChatWindow() end
    local StarterGui = game:GetService("StarterGui"); local TextChatService = game:GetService("TextChatService")
    ChatWindow_Conexoes = {}; ChatWindow_Conexoes.ChatWindow = {}
    local toggleEvent = Instance.new("BindableEvent"); toggleEvent.Name = "ToggleVisibility"; ChatWindow_Conexoes.ChatWindow.ToggleVisibility = toggleEvent
    local setVisibleEvent = Instance.new("BindableEvent"); setVisibleEvent.Name = "SetVisible"; ChatWindow_Conexoes.ChatWindow.SetVisible = setVisibleEvent
    local visibilityChangedEvent = Instance.new("BindableEvent"); visibilityChangedEvent.Name = "VisibilityStateChanged"; ChatWindow_Conexoes.ChatWindow.VisibilityStateChanged = visibilityChangedEvent
    pcall(function() StarterGui:SetCore("CoreGuiChatConnections", ChatWindow_Conexoes) end)
    local function ToggleChat() local wc = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration"); if wc then wc.Enabled = not wc.Enabled; pcall(function() visibilityChangedEvent:Fire(wc.Enabled) end) end end
    toggleEvent.Event:Connect(function() ToggleChat() end)
    setVisibleEvent.Event:Connect(function(visible) local wc = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration"); if wc then wc.Enabled = visible; pcall(function() visibilityChangedEvent:Fire(visible) end) end end)
end

local function DesativarChatWindow()
    if ChatWindow_Conexoes then pcall(function() ChatWindow_Conexoes.ChatWindow.ToggleVisibility:Destroy(); ChatWindow_Conexoes.ChatWindow.SetVisible:Destroy(); ChatWindow_Conexoes.ChatWindow.VisibilityStateChanged:Destroy() end); ChatWindow_Conexoes = nil end
    pcall(function()
        local StarterGui = game:GetService("StarterGui"); local TextChatService = game:GetService("TextChatService")
        local wc = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration"); if wc then wc.Enabled = false end; task.wait(0.1)
        local novas = {}; novas.ChatWindow = {}
        local te = Instance.new("BindableEvent"); te.Name = "ToggleVisibility"; novas.ChatWindow.ToggleVisibility = te
        local se = Instance.new("BindableEvent"); se.Name = "SetVisible"; novas.ChatWindow.SetVisible = se
        local vc = Instance.new("BindableEvent"); vc.Name = "VisibilityStateChanged"; novas.ChatWindow.VisibilityStateChanged = vc
        te.Event:Connect(function() local w = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration"); if w then w.Enabled = not w.Enabled; vc:Fire(w.Enabled) end end)
        se.Event:Connect(function(v) local w = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration"); if w then w.Enabled = v; vc:Fire(v) end end)
        StarterGui:SetCore("CoreGuiChatConnections", novas)
    end)
end

