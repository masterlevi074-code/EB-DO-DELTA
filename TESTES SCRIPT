        bg.Name = "NoahzinName"; bg.Size = UDim2.new(0, 100, 0, 20)
        bg.AlwaysOnTop = true; bg.ExtentsOffset = Vector3.new(0, 3, 0)
        bg.Enabled = ESP_Names; bg.Parent = head
        local tl = bg:FindFirstChild("TextLabel") or Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0); tl.BackgroundTransparency = 1; tl.Text = p.Name
        pcall(function() tl.TextColor3 = CorESP end)
        tl.Font = Enum.Font.GothamBold; tl.TextSize = 12; tl.TextStrokeTransparency = 0; tl.Parent = bg

        -- Barra de vida
